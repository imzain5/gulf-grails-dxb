# Copy to .env.local for local development. Everything here is set in the
# Vercel dashboard for the deployed site — never commit real values.

# The owner's password for /admin. Long and random.
ADMIN_PASSWORD=

# Created for you when you connect a Blob store to the project in the Vercel
# dashboard (Storage → Blob → connect). Without it the site serves the seed
# catalogue in data/seed.ts and /admin refuses to save.
BLOB_READ_WRITE_TOKEN=


# ── Payments ────────────────────────────────────────────────────────────────
#
# Each provider appears at checkout only once its keys are here, and nowhere on
# the site is a payment method advertised that the shop cannot actually take.
# So: set these when you are ready to take that kind of payment, and not
# before. Leaving a block empty is a supported state, not a broken one.
#
# Cash on delivery and bank transfer need nothing and are always available.

# Cards, Apple Pay and Google Pay, via Stripe Checkout.
# Dashboard → Developers → API keys. Use the test key (sk_test_…) until you
# have put a real order through.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks. Add an endpoint pointing at
#   https://gulfgrails.ae/api/payments/card
# subscribed to checkout.session.completed, then copy its signing secret here.
STRIPE_WEBHOOK_SECRET=

# Tabby — four instalments. From the Tabby merchant portal.
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# A secret you invent, set as a header on the webhook you register with Tabby
# pointing at https://gulfgrails.ae/api/payments/tabby
TABBY_WEBHOOK_SECRET=

# Tamara — instalments. From the Tamara partner portal.
TAMARA_API_TOKEN=
# The notification token Tamara issues for webhook authentication. Register the
# webhook at https://gulfgrails.ae/api/payments/tamara
TAMARA_NOTIFICATION_TOKEN=
# Point at sandbox while testing: https://api-sandbox.tamara.co
TAMARA_API_BASE=
